{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_EXTENSIONS": "OFF"
      }
    },
    {
      "name": "dev-debug",
      "displayName": "Development Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "dev-release",
      "displayName": "Development Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "dev-debug-asan",
      "displayName": "Development Debug with ASan/UBSan",
      "inherits": "dev-debug",
      "cacheVariables": {
        "LEXICON_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "lint",
      "displayName": "Clang compile database for linting",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "ci-gcc",
      "displayName": "CI GCC Debug (warnings as errors)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "LEXICON_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ci-clang",
      "displayName": "CI Clang Debug (warnings as errors)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "LEXICON_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ci-asan",
      "displayName": "CI AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LEXICON_ENABLE_SANITIZERS": "ON",
        "LEXICON_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage (GCC)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LEXICON_ENABLE_COVERAGE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug"
    },
    {
      "name": "dev-release",
      "configurePreset": "dev-release"
    },
    {
      "name": "dev-debug-asan",
      "configurePreset": "dev-debug-asan"
    },
    {
      "name": "lint",
      "configurePreset": "lint"
    },
    {
      "name": "ci-gcc",
      "configurePreset": "ci-gcc"
    },
    {
      "name": "ci-clang",
      "configurePreset": "ci-clang"
    },
    {
      "name": "ci-asan",
      "configurePreset": "ci-asan"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    }
  ],
  "testPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 120
      },
      "filter": {
        "exclude": {
          "label": "kde"
        }
      }
    },
    {
      "name": "dev-release",
      "configurePreset": "dev-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 120
      },
      "filter": {
        "exclude": {
          "label": "kde"
        }
      }
    },
    {
      "name": "dev-debug-asan",
      "configurePreset": "dev-debug-asan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 180
      },
      "filter": {
        "exclude": {
          "labels": [
            "kde"
          ]
        }
      }
    },
    {
      "name": "ci-gcc",
      "configurePreset": "ci-gcc",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 180
      },
      "filter": {
        "exclude": {
          "labels": [
            "kde"
          ]
        }
      }
    },
    {
      "name": "ci-clang",
      "configurePreset": "ci-clang",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 180
      },
      "filter": {
        "exclude": {
          "labels": [
            "kde"
          ]
        }
      }
    },
    {
      "name": "ci-asan",
      "configurePreset": "ci-asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 180
      },
      "filter": {
        "exclude": {
          "labels": [
            "kde"
          ]
        }
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 180
      },
      "filter": {
        "exclude": {
          "label": "kde"
        }
      }
    }
  ]
}
