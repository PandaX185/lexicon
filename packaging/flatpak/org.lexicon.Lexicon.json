{
  "app-id": "org.lexicon.Lexicon",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "command": "lexicon",
  "rename-icon": "lexicon",
  "finish-args": [
    "--socket=wayland",
    "--device=dri",
    "--share=network",
    "--filesystem=xdg-config/autostart:create",
    "--talk-name=org.kde.kglobalaccel",
    "--talk-name=org.kde.StatusNotifierWatcher"
  ],
  "modules": [
    {
      "name": "lexicon",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DLEXICON_WITH_WAYLAND=ON"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            ".git",
            ".flatpak-builder",
            "build",
            "build-*"
          ]
        }
      ]
    }
  ]
}
