# Maintainer: Lexicon contributors
pkgname=lexicon
pkgver=0.1.0
pkgrel=1
pkgdesc="Native offline English dictionary daemon for KDE Plasma"
arch=('x86_64')
url="https://github.com/PandaX185/lexicon"
license=('MIT')
depends=(
    'qt6-base'
    'qt6-declarative'
    'qt6-quickcontrols2'
    'qt6-svg'
    'kglobalaccel'
    'kstatusnotifieritem'
    'kdbusaddons'
    'wayland'
)
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'pkgconf')
optdepends=(
    'python: offline translation worker'
    'python-argostranslate: offline translation models'
)
# The release workflow publishes this source tarball together with its SHA-256
# checksum. Regenerate both when bumping pkgver.
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cmake -S "$srcdir/$pkgname-$pkgver" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DLEXICON_WITH_WAYLAND=ON
    cmake --build build
}

check() {
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software \
        ctest --test-dir build --output-on-failure -LE kde
}

package() {
    DESTDIR="$pkgdir" cmake --install build --prefix /usr
}
